    "engines": { "dsh": ">=0.2.0-rc.1" },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
